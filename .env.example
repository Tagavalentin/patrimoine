# ============================================================
# Configuration globale du projet Patrimoine de l'État
# Copier en .env :  cp .env.example .env
# Aucune valeur secrète réelle ne doit être commitée.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=patrimoine
POSTGRES_PASSWORD=patrimoine
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Bases de données (une par service)
AUTH_DB=auth_db
ASSET_DB=asset_db
MAINTENANCE_DB=maintenance_db
INVENTORY_DB=inventory_db
REPORTING_DB=reporting_db

# ---------- Réseau / Ports ----------
# Ports exposés sur l'hôte (modifiable si conflit)
GATEWAY_PORT=80
FRONTEND_PORT=8080
PGADMIN_PORT=5050

# ---------- Authentification ----------
# Secret de signature JWT (à générer : openssl rand -base64 32)
JWT_SECRET=change_me_in_production
JWT_TTL=60

# ---------- Services (URLs internes au réseau Docker) ----------
AUTH_SERVICE_URL=http://auth-service:8000
ASSET_SERVICE_URL=http://asset-service:8000
MAINTENANCE_SERVICE_URL=http://maintenance-service:8000
INVENTORY_SERVICE_URL=http://inventory-service:8000
REPORTING_SERVICE_URL=http://reporting-service:8000
GATEWAY_URL=http://gateway

# ---------- Redis (optionnel, événements inter-services) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---------- Application Laravel racine (legacy / frontend futur) ----------
APP_NAME=Patrimoine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=frontend_db
DB_USERNAME=patrimoine
DB_PASSWORD=patrimoine
